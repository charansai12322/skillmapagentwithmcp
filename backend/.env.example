# SkillMap AI Backend Configuration
# Copy this file to .env and fill in your actual API keys.
# DO NOT COMMIT .env TO VERSION CONTROL.

# AI & LLM Services
# Replace 'sec1' from the original Colab notebook with your actual Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# RapidAPI JSearch Configuration
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=jsearch.p.rapidapi.com
RAPIDAPI_URL=https://jsearch.p.rapidapi.com/search-v2

# Composio MCP Remote Server Configuration
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# Tavily AI Search Configuration (Web Research Tool)
TAVILY_API_KEY=your_tavily_api_key_here


# Server & Runtime Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=15.0
MAX_AGENT_ITERATIONS=8
DEFAULT_COUNTRY=in

# CORS Configuration (comma-separated list of allowed frontend origins)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
